# Production Environment Variables
# Copy this to .env on production server: cp env.production.example .env

# Django Core Settings
# SECRET_KEY almashtirganda: barcha JWT va sessiyalar bekor qilinadi — foydalanuvchilar qayta kiradi.
SECRET_KEY=your-strong-secret-key-here-change-in-production-generate-with-django-secret-key-generator
DEBUG=False
# API admin: https://api.ilmiyfaoliyat.uz/admin — barcha kerakli domenlar (vergul bilan)
ALLOWED_HOSTS=api.ilmiyfaoliyat.uz,ilmiyfaoliyat.uz,www.ilmiyfaoliyat.uz,167.71.53.238,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS bo'sh bo'lsa, settings.py default ro'yxatida https://api.ilmiyfaoliyat.uz bor.
# Agar CSRF_TRUSTED_ORIGINS=.env da berilsa, API admin uchun quyidagilarni qo'shing:
# CSRF_TRUSTED_ORIGINS=https://ilmiyfaoliyat.uz,https://www.ilmiyfaoliyat.uz,https://api.ilmiyfaoliyat.uz

# GitHub Webhooks — deploy (SSH / Actions shart emas). Secret: GitHub webhook "Secret" bilan bir xil.
# Payload URL: https://api.ilmiyfaoliyat.uz/hooks/github/deploy/  |  Events: push  |  JSON
# GITHUB_DEPLOY_WEBHOOK_SECRET=
# GITHUB_DEPLOY_HOOK_BRANCH=master
# GITHUB_DEPLOY_REPO=aiziyrak-coder/phonixB,aiziyrak-coder/phonixF
# DEPLOY_HOOK_SCRIPT=/phonix/deploy_phonix.sh
# Gunicorn user uchun: visudo — deploy skriptini NOPASSWD bilan ishga tushirish kerak bo‘lishi mumkin.

# Versiya / release (Sentry va /health/ javobida)
APP_VERSION=1.0.0
# GIT_REVISION=abc123  # CI/CD da commit SHA

# Monitoring: GET /health/, /health/live/, /health/ready/, /metrics/
# So‘rov loglari: MONITORING_LOG_REQUESTS=true, JSON uchun MONITORING_LOG_JSON=true
# METRICS_SECRET=...  # bo‘lsa /metrics/ uchun X-Metrics-Key majburiy
# Log fayl (read-only Docker da o'chiring): DJANGO_LOG_TO_FILE=false
DJANGO_LOG_TO_FILE=false
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=7

# HttpOnly JWT cookie (DEBUG=False da default yoqilgan). Lokal dev: JWT_USE_HTTPONLY_COOKIES=false
JWT_USE_HTTPONLY_COOKIES=true
JWT_AUTH_COOKIE_DOMAIN=
# JSON javobda access/refresh ko‘rsatish (SPA uchun true)
JWT_RETURN_TOKENS_IN_JSON=true

# Throttle (DRF)
# THROTTLE_ANON=120/minute
# THROTTLE_USER=600/minute
# THROTTLE_AUTH=20/minute
# THROTTLE_GEMINI=40/hour

# Yuklama hajmi (MB, 1–100)
MAX_UPLOAD_MB=10

# Sentry (ixtiyoriy)
# SENTRY_DSN=https://...@.ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Admin login limit (middleware)
# ADMIN_LOGIN_RATELIMIT_PER_IP=30
# ADMIN_LOGIN_RATELIMIT_WINDOW_SEC=900

# API uchun CSP sarlavhasi (bo‘sh = yuborilmasin)
# DJANGO_API_CSP=default-src 'none'

# Database (PostgreSQL recommended for production)
DB_NAME=phoenix_scientific
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
USE_SQLITE=False

# Gunicorn — faqat server ICHIDA (127.0.0.1). Tashqaridan faqat nginx :443 orqali kiriladi.
# 8000 band bo'lsa Phoenixni boshqa portga qo'ying (masalan 8050). Boshqa dasturlarga tegmang.
# Systemd: Environment=GUNICORN_BIND=127.0.0.1:8050 + gunicorn -c gunicorn.conf.py
#          yoki ExecStart da --bind 127.0.0.1:8050
# Nginx (faqat api.ilmiyfaoliyat.uz bloki): proxy_pass → http://127.0.0.1:8050
#
# Click / Payme: merchant panelda callback URL odatda https://api.ilmiyfaoliyat.uz/... (port yo'q).
# Ichki 8050 o'zgarishi shlyuzlarga TASIR QILMAYDI — tashqi domen o'zgarmasa kifoya.
#
# CORS — SPA domenlari aniq https bilan (www ham); bo'sh yoki noto'g'ri bo'lsa login preflight yiqiladi
# Eslatma: settings.py da CORS_ALLOWED_ORIGIN_REGEXES ilmiyfaoliyat.uz va www uchun ham qo‘llanadi (.env xatosi uchun).
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://ilmiyfaoliyat.uz,https://www.ilmiyfaoliyat.uz,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Click return_url va boshqa redirectlar
FRONTEND_BASE_URL=https://ilmiyfaoliyat.uz

# Click Payment Settings
CLICK_MERCHANT_ID=45730
CLICK_SERVICE_ID=82154
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Service-specific (Click panel): masalan CLICK_SERVICE_82154_SECRET_KEY=
# Click HTTP timeout (sekund)
CLICK_HTTP_TIMEOUT_SEC=45

# Gemini AI — faqat server .env da (GOOGLE_API_KEY / GENAI_API_KEY ham qo‘llanadi)
GEMINI_API_KEY=
# Masalan: gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_PLAGIARISM_INPUT_CHARS=12000

# Email (production tekshiruv ro‘yxati)
# - EMAIL_HOST_USER / EMAIL_HOST_PASSWORD to‘ldirilgan
# - DEFAULT_FROM_EMAIL domen SPF/DKIM bilan mos
# - Gmail: App Password yoki SMTP relay

# Email Settings (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@ilmiyfaoliyat.uz

# Redis (for Celery, optional)
REDIS_URL=redis://localhost:6379/0

# Django Log Level
DJANGO_LOG_LEVEL=INFO
